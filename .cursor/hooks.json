{
  "version": 1,
  "hooks": {
    "beforeSubmitPrompt": [
      {
        "command": "node .cursor/hooks/record-chat.mjs",
        "timeout": 15
      }
    ],
    "afterAgentResponse": [
      {
        "command": "node .cursor/hooks/record-chat.mjs",
        "timeout": 15
      }
    ],
    "stop": [
      {
        "command": "node .cursor/hooks/jev-review-stop.mjs",
        "timeout": 15,
        "loop_limit": 5
      }
    ]
  }
}
